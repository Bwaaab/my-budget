{
  "name": "smart-ai-budget",
  "version": "1.0.0",
  "description": "스마트 AI 가계부 - PC & 스마트폰 연동, 영수증 및 카드 알림 캡처 자동 인식",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"node server/server.js\" \"npm --prefix client run dev\"",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/server.js"
  },
  "keywords": [
    "budget",
    "household-account",
    "ai",
    "gemini",
    "ocr",
    "receipt-scanner"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^0.1.1",
    "better-sqlite3": "^11.8.1",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  }
}
